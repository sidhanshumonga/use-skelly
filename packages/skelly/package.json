{
  "name": "use-skelly",
  "version": "0.4.0",
  "description": "Skeleton screens that learn your UI. Measured from your real DOM at runtime, then remembered \u2014 no build step, nothing to regenerate.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidhanshumonga/use-skelly.git",
    "directory": "packages/skelly"
  },
  "homepage": "https://useskelly.dev",
  "bugs": {
    "url": "https://github.com/sidhanshumonga/use-skelly/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "skelly": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/style.css dist/style.css",
    "watch": "tsc -w"
  },
  "keywords": [
    "skeleton",
    "loading",
    "placeholder",
    "shimmer",
    "react",
    "nextjs",
    "vue",
    "svelte",
    "layout",
    "self-learning",
    "no-build-step",
    "suspense-fallback"
  ],
  "author": "Skelly Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
